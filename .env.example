# Server-side only. Add these in the deployment environment, never in VITE_* variables.
OPENAI_API_KEY=
LUNA_OPENAI_MODEL=gpt-5-mini
# Required to enable private API coaching. Use a random value at least 24 characters long,
# then enter the same value under Settings > Private Luna coaching on the trusted device.
LUNA_API_ACCESS_TOKEN=
# Optional comma-separated browser origins. When blank, Luna accepts only the deployment's own origin.
LUNA_ALLOWED_ORIGIN=

# Optional client override when the Luna endpoint is hosted separately.
# VITE_LUNA_API_URL=https://your-domain.example/api/luna-debrief
